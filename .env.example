# Anthropic API key — obtener en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Token de autenticación para el endpoint /api/analyze
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SPLITR_TOKEN y VITE_SPLITR_TOKEN deben tener el mismo valor
SPLITR_TOKEN=tu-token-aqui
VITE_SPLITR_TOKEN=tu-token-aqui
